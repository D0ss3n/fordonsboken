rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/appData/{documentId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/migrationStatus/{migrationId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public-share ownership mappings are managed only by trusted callable functions.
    match /users/{userId}/publicShareMappings/{vehicleId} {
      allow read, write: if false;
    }

    // Transfer requests are managed only by Admin SDK callable functions.
    match /transferRequests/{transferId} {
      allow read, write: if false;
    }

    match /users/{userId}/vehicleMemberships/{vehicleId} {
      function vehiclePath() {
        return /databases/$(database)/documents/vehicles/$(vehicleId);
      }
      function memberPath() {
        return /databases/$(database)/documents/vehicles/$(vehicleId)/members/$(userId);
      }

      allow get, list: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['schemaVersion', 'vehicleId', 'role', 'active'])
        && request.resource.data.vehicleId == vehicleId
        && request.resource.data.role == 'owner'
        && request.resource.data.active == true
        && getAfter(vehiclePath()).data.createdByUid == userId
        && getAfter(memberPath()).data.uid == userId;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data == resource.data;
      allow delete: if false;
    }

    match /users/{userId}/privateVehicles/{vehicleId}/{collection}/{documentId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /vehicles/{vehicleId} {
      function memberPath() {
        return /databases/$(database)/documents/vehicles/$(vehicleId)/members/$(request.auth.uid);
      }
      function isActiveMember() {
        return request.auth != null
          && existsAfter(memberPath())
          && getAfter(memberPath()).data.uid == request.auth.uid
          && getAfter(memberPath()).data.active == true;
      }
      function isActiveOwner() {
        return isActiveMember() && getAfter(memberPath()).data.role == 'owner';
      }

      allow get: if isActiveMember();
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['schemaVersion', 'createdByUid', 'vehicle'])
        && request.resource.data.schemaVersion == 2
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.vehicle is map
        && request.resource.data.vehicle.keys().hasOnly(['id', 'name', 'type', 'make', 'model', 'year', 'registration', 'vin', 'mileage']);
      allow update: if isActiveOwner()
        && resource.data.createdByUid == request.resource.data.createdByUid
        && request.resource.data.keys().hasOnly(['schemaVersion', 'createdByUid', 'vehicle'])
        && request.resource.data.vehicle is map
        && request.resource.data.vehicle.keys().hasOnly(['id', 'name', 'type', 'make', 'model', 'year', 'registration', 'vin', 'mileage']);
      allow delete: if false;

      match /members/{memberUid} {
        function parentVehiclePath() {
          return /databases/$(database)/documents/vehicles/$(vehicleId);
        }

        allow get: if request.auth != null && request.auth.uid == memberUid;
        allow list: if false;
        allow create: if request.auth != null
          && request.auth.uid == memberUid
          && request.resource.data.keys().hasOnly(['schemaVersion', 'uid', 'role', 'active', 'startedAt', 'ownershipHistoryId'])
          && request.resource.data.schemaVersion == 2
          && request.resource.data.uid == memberUid
          && request.resource.data.role == 'owner'
          && request.resource.data.active == true
          && getAfter(parentVehiclePath()).data.createdByUid == memberUid;
        allow update: if request.auth != null
          && request.auth.uid == memberUid
          && request.resource.data == resource.data;
        allow delete: if false;
      }

      match /ownershipHistory/{ownershipId} {
        function memberPath() {
          return /databases/$(database)/documents/vehicles/$(vehicleId)/members/$(request.auth.uid);
        }
        function isActiveOwner() {
          return request.auth != null
            && existsAfter(memberPath())
            && getAfter(memberPath()).data.uid == request.auth.uid
            && getAfter(memberPath()).data.active == true
            && getAfter(memberPath()).data.role == 'owner';
        }

        allow get, list: if request.auth != null
          && existsAfter(memberPath())
          && getAfter(memberPath()).data.active == true;
        allow create: if isActiveOwner()
          && request.resource.data.keys().hasOnly(['schemaVersion', 'ownerUid', 'startedAt', 'endedAt', 'source'])
          && request.resource.data.ownerUid == request.auth.uid;
        allow update: if isActiveOwner() && request.resource.data == resource.data;
        allow delete: if false;
      }

      match /events/{eventId} {
        function memberPath() {
          return /databases/$(database)/documents/vehicles/$(vehicleId)/members/$(request.auth.uid);
        }
        function isActiveOwner() {
          return request.auth != null
            && existsAfter(memberPath())
            && getAfter(memberPath()).data.active == true
            && getAfter(memberPath()).data.role == 'owner';
        }

        allow get, list: if request.auth != null
          && existsAfter(memberPath())
          && getAfter(memberPath()).data.active == true;
        allow create: if isActiveOwner()
          && request.resource.data.keys().hasOnly(['schemaVersion', 'id', 'category', 'title', 'date', 'mileage', 'sourceType', 'createdByUid'])
          && request.resource.data.schemaVersion == 2
          && request.resource.data.id == eventId
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.sourceType in ['owner_entry', 'receipt', 'document', 'workshop', 'imported'];
        allow update: if isActiveOwner()
          && resource.data.createdByUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['schemaVersion', 'id', 'category', 'title', 'date', 'mileage', 'sourceType', 'createdByUid'])
          && request.resource.data.createdByUid == resource.data.createdByUid
          && request.resource.data.sourceType in ['owner_entry', 'receipt', 'document', 'workshop', 'imported'];
        allow delete: if isActiveOwner()
          && resource.data.createdByUid == request.auth.uid;
      }

      match /eventCorrections/{correctionId} {
        function memberPath() {
          return /databases/$(database)/documents/vehicles/$(vehicleId)/members/$(request.auth.uid);
        }

        allow get, list: if request.auth != null
          && existsAfter(memberPath())
          && getAfter(memberPath()).data.active == true;
        allow create: if request.auth != null
          && existsAfter(memberPath())
          && getAfter(memberPath()).data.active == true
          && getAfter(memberPath()).data.role == 'owner'
          && request.resource.data.keys().hasOnly(['schemaVersion', 'eventId', 'createdByUid', 'note', 'createdAt'])
          && request.resource.data.eventId is string
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.note is string;
        allow update, delete: if false;
      }

      match /problems/{problemId} {
        function memberPath() {
          return /databases/$(database)/documents/vehicles/$(vehicleId)/members/$(request.auth.uid);
        }
        allow get, list: if request.auth != null
          && existsAfter(memberPath())
          && getAfter(memberPath()).data.active == true;
        allow create: if request.auth != null
          && existsAfter(memberPath())
          && getAfter(memberPath()).data.active == true
          && getAfter(memberPath()).data.role == 'owner'
          && request.resource.data.keys().hasOnly(['schemaVersion', 'id', 'title', 'date', 'mileage', 'status', 'createdByUid'])
          && request.resource.data.id == problemId
          && request.resource.data.createdByUid == request.auth.uid;
        allow update: if request.auth != null
          && existsAfter(memberPath())
          && getAfter(memberPath()).data.active == true
          && getAfter(memberPath()).data.role == 'owner'
          && resource.data.createdByUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['schemaVersion', 'id', 'title', 'date', 'mileage', 'status', 'createdByUid'])
          && request.resource.data.createdByUid == resource.data.createdByUid;
        allow delete: if request.auth != null
          && existsAfter(memberPath())
          && getAfter(memberPath()).data.active == true
          && getAfter(memberPath()).data.role == 'owner'
          && resource.data.createdByUid == request.auth.uid;
      }

      match /publicShares/{shareId} {
        allow get: if true;
        allow list: if false;
        allow create: if isActiveOwner()
          && request.resource.data.keys().hasOnly(['schemaVersion', 'vehicle', 'events', 'updatedAt'])
          && request.resource.data.schemaVersion == 2
          && request.resource.data.vehicle is map
          && request.resource.data.events is list;
        allow update: if isActiveOwner()
          && request.resource.data.keys().hasOnly(['schemaVersion', 'vehicle', 'events', 'updatedAt'])
          && request.resource.data.schemaVersion == 2
          && request.resource.data.vehicle is map
          && request.resource.data.events is list;
        allow delete: if isActiveOwner();
      }
    }

    match /publicVehicles/{vehicleId} {
      // Random bearer tokens identify only a sanitized profile. Legacy documents
      // containing ownerUid are denied immediately after this ruleset is deployed.
      allow get: if resource.data.schemaVersion == 2
        && resource.data.keys().hasOnly(['schemaVersion', 'vehicle', 'events', 'updatedAt'])
        && resource.data.vehicle is map
        && resource.data.vehicle.keys().hasOnly(['name', 'type', 'make', 'model', 'year', 'mileage'])
        && resource.data.events is list;
      allow list: if false;
      allow create, update, delete: if false;
    }
  }
}
