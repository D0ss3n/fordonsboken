rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/appData/{documentId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /publicVehicles/{vehicleId} {
      // A share link can read one selected document, but cannot browse the collection.
      allow get: if true;
      allow list: if false;
      // Only the creator can publish, and ownership cannot be transferred by
      // changing ownerUid in an update. Transfers need a separate trusted flow.
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerUid', 'vehicle', 'events', 'updatedAt'])
        && request.resource.data.vehicle is map
        && request.resource.data.events is list
        && request.resource.data.updatedAt is number;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.keys().hasOnly(['ownerUid', 'vehicle', 'events', 'updatedAt'])
        && request.resource.data.vehicle is map
        && request.resource.data.events is list
        && request.resource.data.updatedAt is number;
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
  }
}
